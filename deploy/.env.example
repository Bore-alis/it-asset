# cp .env.example .env 후 값을 채워서 사용. .env 는 커밋하지 않는다.
# 외부에 여는 HTTP 포트
HTTP_PORT=80

DB_USER=asset
DB_PASSWORD=change-me

# Active Directory
APP_LDAP_URL=ldap://ad.example.local:389
APP_LDAP_DOMAIN=@example.local
APP_LDAP_ALLOWED_OU_BASE=OU=IT,DC=example,DC=local

# SMTP
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=no-reply@example.com
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true
APP_MAIL_CC=helpdesk@example.com

# Synology NAS
NAS0_NAME=SAMPLE-NAS
NAS0_URL=https://nas.example.local:5001
NAS0_USERNAME=
NAS0_PASSWORD=

# 퇴직자 증적
APP_WIPE_RETENTION_YEARS=3
APP_WIPE_PURGE_CRON=0 0 3 * * *
